-- S.T.U.N. Runner: 60 fps by in-engine interpolation (live prototype)
--
-- The game updates its logic and 3D scene 20 times a second (one ADSP render per tick).
-- This script makes the game's own ADSP render two extra frames per tick, with the camera
-- and all moving objects placed 1/3 and 2/3 of the way to the next tick, and shows them
-- in between the real frames. Game logic still runs at its normal 20 ticks per second.
--
-- Needs overclocking (Tab > Slider Controls, MAME started with -cheat): gsp, adsp and
-- maincpu at about 400%. Without enough overclock the extra frames are dropped and the
-- game falls back to its normal 20 fps pacing (never runs fast or slow because of this).
-- RAM/IO patching only, ROMs untouched. See ~/CLAUDE.md for how it works.

-- MAME re-runs the autoboot script after a machine reset; keep only the first instance.
if STUN60_INSTANCE then return end
STUN60_INSTANCE = true
DBG = os.getenv("STUN60_DEBUG") == "1"
local VERIFY = os.getenv("STUN60_VERIFY") == "1"   -- headless check: also render t=0 and compare
local LOGF   = os.getenv("STUN60_LOG")            -- optional log file
local RELAX  = os.getenv("STUN60_RELAX") == "1"    -- testing: ignore deadlines (slow motion, shows every frame)
local TS     = {1/3, 2/3}
local function DL(x) if RELAX then return x + 1e6 end return x end

local mach = manager.machine
local m    = mach.devices[":mainpcb:maincpu"]
local ms   = m.spaces["program"]
local MPC  = m.state["PC"]
local MA2  = m.state["A2"]
local MD5  = m.state["D5"]
local ad   = mach.devices[":mainpcb:adsp"].spaces["data"]
local gsp  = mach.devices[":mainpcb:gsp"].spaces["program"]
local scr  = mach.screens[":mainpcb:screen"]
local FP   = scr.frame_period
local function now() return mach.time:as_double() / FP end   -- in screen refreshes

local logf = LOGF and io.open(LOGF, "w")
local function L(s) if logf then logf:write(string.format("%10.3f %s\n", now(), s)); logf:flush() end end

-- ---------------------------------------------------------------------------
-- state
local self_write = false        -- our own writes must not trigger our own taps
local bank = 0                  -- 68k buffer bank last selected by the 68010
local rec, jobs = nil, {}       -- recorded ADSP job uploads {addr, data, pc}
local jobcount = 0
local cycle = nil               -- current interpolation cycle (one per real list)
local cap_target = 3
local st = {gspf = 0, extra = 0, ticks = 0, drop = 0}
local shown = {gspf = "--", extra = "--", ticks = "--", drop = "--"}

local POS = {[0x02E342]=1,[0x02E34C]=1,[0x02E356]=1,[0x02E24A]=1,[0x02E250]=1,[0x02E256]=1,
             [0x02E16C]=1,[0x02E176]=1,[0x02E180]=1,[0x02DED6]=1,[0x02DEE0]=1,[0x02DEEA]=1}
local MAT = {[0x022DE0]=1,[0x022DE2]=1,[0x022DE4]=1,[0x022DE6]=1,[0x022DE8]=1}
local function s16(v) v = v & 0xffff; if v >= 0x8000 then return v - 0x10000 end return v end
local function s32(v) if v >= 0x80000000 then return v - 0x100000000 end return v end
local function W68(a, d) self_write = true; ms:write_u16(a, d); self_write = false end
local function WG(a, d)  self_write = true; gsp:write_u16(a, d); self_write = false end

-- ---------------------------------------------------------------------------
-- recording the 68010's ADSP job uploads
local function on_ctl(o, d)
  if self_write then return end
  if o == 0x818006 or o == 0x818016 then
    bank = (o == 0x818016) and 1 or 0
    if DBG then L(string.format("68010 bank -> %d (pc %06X)", bank, MPC.value)) end
    rec = {pre = ad:read_range(0, 0x1FFE, 16)}   -- ADSP memory as it was before this job
  elseif o == 0x81801A and rec and MPC.value ~= 0x02E464 and MPC.value ~= 0x02E414 then
    jobs[#jobs+1] = rec; rec = nil; jobcount = jobcount + 1
    if DBG then L(string.format("68010 job %d uploaded (%d writes)", jobcount, #jobs[#jobs])) end
    if #jobs > 8 then table.remove(jobs, 1) end
  end
end
local function on_data(o, d)
  if self_write or not rec then return end
  local pc = MPC.value
  if (POS[pc] or MAT[pc]) and not (o >= 0x80BFC8 and o <= 0x80BFFC) then
    rec[#rec+1] = {o, d & 0xffff, pc, MA2.value}     -- object field: remember which 68010 object
  else
    rec[#rec+1] = {o, d & 0xffff, pc}
  end
end

-- Interpolate a recorded job toward the next one. Camera words are matched by address;
-- object matrices/positions by 68010 object pointer and field order (ADSP slots can move).
local function obj_fields(J)
  local f = {}
  for _,w in ipairs(J) do
    if w[4] then
      local k = w[4]; f[k] = f[k] or {}
      local l = f[k]; l[#l+1] = w[2]
    end
  end
  return f
end
local function lerp_job(A, B, t)
  local bv = {}; for _,w in ipairs(B) do bv[w[1]] = w[2] end
  local bo = obj_fields(B)
  local cnt = {}
  local out, i = {}, 1
  while i <= #A do
    local o, d, pc, obj = A[i][1], A[i][2], A[i][3], A[i][4]
    local nx = A[i+1]
    if obj then
      local k = (cnt[obj] or 0) + 1
      local bl = bo[obj]
      if POS[pc] and nx and nx[4] == obj and nx[1] == o + 2 then
        if bl and bl[k] and bl[k+1] then
          local va, vb = s32((d << 16) | nx[2]), s32((bl[k] << 16) | bl[k+1])
          local v = math.floor(va + (vb - va) * t + 0.5) & 0xffffffff
          out[#out+1] = {o, v >> 16}; out[#out+1] = {o+2, v & 0xffff}
        else
          out[#out+1] = {o, d}; out[#out+1] = {o+2, nx[2]}
        end
        cnt[obj] = k + 1; i = i + 2
      else
        if MAT[pc] and bl and bl[k] then d = math.floor(s16(d) + (s16(bl[k]) - s16(d)) * t + 0.5) & 0xffff end
        out[#out+1] = {o, d}; cnt[obj] = k; i = i + 1
      end
    elseif POS[pc] and nx and nx[1] == o + 2 and bv[o] and bv[o+2] then      -- camera position
      local va, vb = s32((d << 16) | nx[2]), s32((bv[o] << 16) | bv[o+2])
      local v = math.floor(va + (vb - va) * t + 0.5) & 0xffffffff
      out[#out+1] = {o, v >> 16}; out[#out+1] = {o+2, v & 0xffff}; i = i + 2
    else
      if MAT[pc] and bv[o] then d = math.floor(s16(d) + (s16(bv[o]) - s16(d)) * t + 0.5) & 0xffff end  -- camera matrix
      out[#out+1] = {o, d}; i = i + 1
    end
  end
  return out
end

-- ---------------------------------------------------------------------------
-- ADSP helpers
local function adsp_snapshot() return ad:read_range(0, 0x1FFE, 16) end
local function adsp_restore(snap)
  local cur = ad:read_range(0, 0x1FFE, 16)
  if cur == snap then return end
  for c = 0, #snap - 1, 64 do
    if snap:sub(c+1, c+64) ~= cur:sub(c+1, c+64) then
      for b = c, math.min(c + 62, #snap - 2), 2 do
        if snap:sub(b+1, b+2) ~= cur:sub(b+1, b+2) then
          ad:write_u16(b // 2, string.unpack("<I2", snap, b + 1))
        end
      end
    end
  end
end
local job_running, job_done = false, false
-- Two stages: MAME applies the buffer-bank switch with a delay, so the ADSP must not
-- run (and write output) until the switch has really happened.
local function start_job_1()
  W68(0x81800A, 0); W68(0x818008, 0)                     -- halt ADSP (/BR)
  W68(bank == 1 and 0x818006 or 0x818016, 0)             -- ADSP will write the already-copied bank
end
local function start_job_2(words)
  job_running, job_done = true, false
  self_write = true
  for _,w in ipairs(words) do ms:write_u16(w[1], w[2]) end   -- includes the $80BFFE job trigger
  self_write = false
  W68(0x818018, 0); W68(0x81801A, 0)                     -- release
end
local function read_output()
  local n = ms:read_u16(0x810000)
  if n == 0 or n > 6000 then return nil end
  local o = {}
  for i = 1, n do o[i] = ms:read_u16(0x810000 + 2*i) end
  if o[n] ~= 0xFFFF then return nil end
  return o
end

-- ---------------------------------------------------------------------------
-- GSP list handling
local function find_block(mb, d2)
  if not d2 or d2 < 2 or d2 > 6000 then return nil end
  local a = mb + 0x10
  for k = 0, 800 do
    local p = a + 16*k
    if gsp:read_u16(p) == 0x7000 and gsp:read_u16(p + 16*d2) == 0xFFFF then return p end
  end
  return nil
end
local function write_list(c, words)
  local p = c.p
  WG(p, 0x7000)
  self_write = true
  for i = 1, #words do gsp:write_u16(p + 16*i, words[i]) end
  local q = p + 16*(#words + 1)
  for i = 1, #c.tail do gsp:write_u16(q + 16*(i-1), c.tail[i]) end
  self_write = false
end

-- ---------------------------------------------------------------------------
-- cycle control
local function release_tick(c)
  if c.tick_owed then c.tick_owed = false; W68(0xFFDB48, 0xFFFF) end
end
local function end_cycle(c, why)
  if c.ended then return end
  c.ended = true
  if c.holding_bb4 then c.holding_bb4 = false; W68(0xFF9BB4, 1) end
  cap_target = math.max(1, 3 - c.published)
  release_tick(c)
  if why then st.drop = st.drop + (#TS - c.published); L(string.format("cycle end: %s published %d consumed %d age %.2f", why, c.published, c.consumed, now() - c.t0)) end
  if cycle == c then cycle = nil end
end

-- The worker is a state machine (no coroutines: MAME 0.285 crashes on exit while a
-- coroutine sits in emu.wait). It is advanced ("pumped") from read taps on the flags
-- the 68010 and the GSP poll while they wait, and once per frame.
local function try_publish(c)
  local i = c.published + 1
  local o = c.outs[i]
  if o and c.consumed >= i and gsp:read_u16(c.mb) == 0 and now() < DL(c.t0 + i + 0.95) then
    write_list(c, o); WG(c.mb, 0xFFFF); c.published = i; st.extra = st.extra + 1
    L("published extra "..i)
    return true
  end
end

local function in_copy()
  local pc = MPC.value
  return (pc >= 0x02247A and pc <= 0x02249C) or (pc >= 0x02F0AE and pc <= 0x02F0F6)
end

local function step(c)
  local t = now()
  for _ = 1, 8 do
    local s0 = c.state
    if c.ended then return end
    if s0 == "wait_real" then
      if c.real_done then
        if t > DL(c.t0 + 1.4) then return end_cycle(c, "adsp too slow (overclock adsp)") end
        local n = #jobs
        if n < 3 then return end_cycle(c, "no jobs") end
        c.A, c.B = jobs[n-2], jobs[n-1]
        c.state = "wait_copy"
      elseif t > DL(c.t0 + 2.6) or t > c.t0 + 20 then return end_cycle(c, "real job late")
      end
    elseif s0 == "wait_copy" then
      -- the 68010 copies the previous job's output (other bank) to the GSP once per tick;
      -- we may only switch banks after that copy has started ($FFDB4E written) and finished
      if c.copied and not in_copy() then
        c.snap = adsp_snapshot(); c.idx = 1; c.state = "start_job"
      end
    elseif s0 == "start_job" then
      local tt = c.tlist[c.idx]
      if not tt or (tt > 0 and t > DL(c.t0 + #c.outs + 1 + 0.6)) then
        c.state = "release"
      else
        if DBG then L(string.format("our job t=%.2f start, 68k bank %d -> %d", tt, bank, bank ~ 1)) end
        start_job_1()
        c.tbank = t; c.state = "bank"
      end
    elseif s0 == "bank" then
      if t > c.tbank + 0.01 then
        adsp_restore(c.A.pre)                          -- ADSP state as it was before job A
        start_job_2(lerp_job(c.A, c.B, c.tlist[c.idx]))
        c.tjob = t; c.state = "job"
      end
    elseif s0 == "job" then
      if job_done then
        job_running = false
        W68(bank == 1 and 0x818016 or 0x818006, 0)    -- deferred: 68k will see the bank the ADSP wrote
        c.tsw = t; c.state = "read"
      elseif t > c.tjob + 12 then                     -- safety net: never freeze the game
        job_running = false
        W68(bank == 1 and 0x818016 or 0x818006, 0)
        adsp_restore(c.snap)
        return end_cycle(c, "extra ADSP job never finished")
      end
    elseif s0 == "read" then
      local o = (t > c.tsw + 0.01) and read_output()
      if o or t > c.tsw + 0.1 then
        local tt = c.tlist[c.idx]
        if tt == 0 then
          local same = 0
          for i = 1, (o and #o or 0) do if gsp:read_u16(c.p + 16*i) == o[i] then same = same + 1 end end
          L(string.format("verify t=0: %d of %d words match the real list (%d)", same, o and #o or 0, c.d2))
        else
          c.outs[#c.outs+1] = o or false
        end
        c.idx = c.idx + 1; c.state = "start_job"
      end
    elseif s0 == "release" then
      adsp_restore(c.snap)
      c.holding_bb4 = false; W68(0xFF9BB4, 1)      -- the 68010 may start its next ADSP job at its next tick
      c.state = "publish"
    elseif s0 == "publish" then
      if c.published >= #c.outs then
        if #c.outs < #TS then return end_cycle(c, "adsp late (overclock adsp)") end
        c.state = "wait_last"
      elseif c.outs[c.published + 1] == false then return end_cycle(c, "bad output")
      elseif t > DL(c.t0 + c.published + 1 + 0.95) then return end_cycle(c, "gsp late (overclock gsp)")
      end
    elseif s0 == "wait_last" then
      if c.consumed >= #TS + 1 then return end_cycle(c)
      elseif t > DL(c.t0 + 3.6) or t > c.t0 + 40 then return end_cycle(c, "last frame late") end
    end
    if c.state ~= "publish" and c.state ~= "wait_last" then try_publish(c) end
    if c.state == "publish" then try_publish(c) end
    if c.state == s0 then return end
    L("state "..s0.." -> "..c.state)
  end
end

local pumpn = 0
local cpu_time = 0
local function pump()
  local c = cycle
  if not c then return end
  pumpn = pumpn + 1
  if pumpn % 16 ~= 0 then return end
  local t0 = os.clock()
  step(c)
  cpu_time = cpu_time + os.clock() - t0
end

-- the 68010 publishes a new real list (mailbox = FFFF)
local function on_mailbox(o, d)
  if self_write or (o ~= 0xFFF9FC00 and o ~= 0xFFFCFC00) then return end
  d = d & 0xffff
  if d == 0xFFFF then
    if cycle then end_cycle(cycle, "superseded") end
    local d2 = ms:read_u16(0xFFDB4E)
    local p = find_block(o, d2)
    if not p then cap_target = 3; return end
    local tail = {}
    local q = p + 16*(d2 + 1)
    for i = 1, 700 do tail[i] = gsp:read_u16(q + 16*(i-1)) end
    local tl = {}
    if VERIFY then tl[#tl+1] = 0 end
    for _,t in ipairs(TS) do tl[#tl+1] = t end
    local c = {mb = o, p = p, d2 = d2, tail = tail, t0 = now(), consumed = 0, published = 0,
               real_done = false, holding_bb4 = false, tick_owed = false,
               state = "wait_real", outs = {}, tlist = tl, nj0 = jobcount}
    cycle = c; cap_target = 1
    L(string.format("new cycle mb %X p %X d2 %d", o, p, d2))
  elseif d == 0 and cycle and o == cycle.mb then
    cycle.consumed = cycle.consumed + 1                      -- the GSP finished a list from this buffer
    L("consumed "..cycle.consumed)
  end
end

-- ADSP "job done" flag
local function on_done(o, d)
  if self_write or (d & 0xffff) ~= 1 then return end
  if DBG then L(string.format("done flag (ours %s) pc %06X", tostring(job_running), MPC.value)) end
  if job_running then job_done = true; return 0 end            -- our extra job
  local c = cycle
  if c and not c.ended and not c.real_done and jobcount > c.nj0 then
    c.real_done = true; c.holding_bb4 = true; return 0         -- hold the 68010 while we use the ADSP
  end
end

-- game tick (GSP frame interrupt -> $FFDB48 = FFFF)
local function on_tick(o, d)
  if self_write or (d & 0xffff) ~= 0xFFFF then return end
  local c = cycle
  if c and not c.ended then c.tick_owed = true; return 0 end
  st.ticks = st.ticks + 1
end

-- ---------------------------------------------------------------------------
local installed, nfr = false, 0
STUN60_RESET_SUB = emu.add_machine_reset_notifier(function()
  cycle = nil; job_running = false; job_done = false; rec = nil; jobs = {}; cap_target = 3
  L("machine reset")
end)
emu.register_frame_done(function()
  nfr = nfr + 1
  if not installed and mach.time:as_double() > 5 then
    -- (68010 RAM taps installed early get dropped by a memory remap at boot)
    installed = true
    tap_ctl  = ms:install_write_tap(0x818000, 0x81807F, "s60ctl", on_ctl)
    tap_dat  = ms:install_write_tap(0x808000, 0x80BFFF, "s60dat", on_data)
    tap_done = ms:install_write_tap(0xFF9BB4, 0xFF9BB5, "s60done", on_done)
    tap_tick = ms:install_write_tap(0xFFDB48, 0xFFDB49, "s60tick", on_tick)
    tap_mba  = gsp:install_write_tap(0xFFF9FC00, 0xFFF9FC0F, "s60mba", on_mailbox)
    tap_mbb  = gsp:install_write_tap(0xFFFCFC00, 0xFFFCFC0F, "s60mbb", on_mailbox)
    pump_a   = gsp:install_read_tap(0xFFF9FC00, 0xFFF9FC0F, "s60pa", function() pump() end)
    pump_b   = gsp:install_read_tap(0xFFFCFC00, 0xFFFCFC0F, "s60pb", function() pump() end)
    -- The 68010 wait loops give up (and restart the game) after a fixed number of polls.
    -- While we are the reason it waits, keep its loop counter (D5) fresh.
    pump_t   = ms:install_read_tap(0xFFDB48, 0xFFDB49, "s60pt", function()
      if cycle then local pc = MPC.value; if pc >= 0x02FC7C and pc <= 0x02FCB6 then MD5.value = 0x80000 end end
      pump() end)
    pump_d   = ms:install_read_tap(0xFF9BB4, 0xFF9BB5, "s60pd", function()
      if cycle then local pc = MPC.value; if pc >= 0x02C3AC and pc <= 0x02C3DA then MD5.value = 0 end end
      pump() end)
    tap_copy = ms:install_write_tap(0xFFDB4E, 0xFFDB4F, "s60copy", function()
      if DBG then L(string.format("68010 copy start d2=%d bank %d", ms:read_u16(0xFFDB4E), bank)) end
      if cycle and not self_write then cycle.copied = true end end)
    tap_fps  = gsp:install_write_tap(0xFFF716B0, 0xFFF716BF, "s60fps", function() st.gspf = st.gspf + 1 end)
  end
  if installed then gsp:write_u16(0xFFF77E80, cap_target) end
  if cycle then step(cycle) end
  if os.getenv("STUN60_PCLOG") and MPC.value == 0x02128A and not STACKDONE then
    STACKDONE = true
    local sp = m.state["A7"].value
    local t = {}
    for i = 0, 15 do t[#t+1] = string.format("%08X", ms:read_u32(sp + 4*i)) end
    L("68010 in restart routine, stack: "..table.concat(t, " "))
  end
  if os.getenv("STUN60_PCLOG") and now() > 2175 and now() < 2370 and nfr % 5 == 0 then
    L(string.format("pc68k %06X gsp_pc %08X adsp_pc %04X mbA %04X mbB %04X bb4 %04X db48 %04X", MPC.value,
      mach.devices[":mainpcb:gsp"].state["PC"].value, mach.devices[":mainpcb:adsp"].state["PC"].value,
      gsp:read_u16(0xFFF9FC00), gsp:read_u16(0xFFFCFC00), ms:read_u16(0xFF9BB4), ms:read_u16(0xFFDB48)))
  end
  if nfr % 60 == 0 then
    for k,v in pairs(st) do shown[k] = tostring(v); st[k] = 0 end
    if cycle then L(string.format("flags 80BFC6=%04X FF9C74=%02X FF9C72=%02X adsp_irq_pc=%06X", ms:read_u16(0x80BFC6), ms:read_u8(0xFF9C74), ms:read_u8(0xFF9C72), MPC.value)) end
    if cycle then L(string.format("cycle state %s real_done %s consumed %d published %d owed %s age %.1f", cycle.state, tostring(cycle.real_done), cycle.consumed, cycle.published, tostring(cycle.tick_owed), now()-cycle.t0)) end
    L(string.format("per second: drawn %s, extra %s, ticks %s, dropped %s, lua step ms %.1f, pump calls %d", shown.gspf, shown.extra, shown.ticks, shown.drop, cpu_time*1000, pumpn - (LASTP or 0)))
    LASTP = pumpn
    cpu_time = 0
  end
  scr:draw_box(2, 2, 150, 24, 0xc0000000, 0xffffff00)
  scr:draw_text(5, 3, "Drawn FPS: " .. shown.gspf .. "  ticks: " .. shown.ticks, 0xff000000)
  scr:draw_text(5, 13, "interp: " .. shown.extra .. "  dropped: " .. shown.drop, 0xff000000)
end)
