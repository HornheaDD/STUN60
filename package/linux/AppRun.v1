#!/bin/sh
# S.T.U.N. Runner 60 fps (custom MAME 0.285 + interpolation script). Put stunrun.zip next to this file.
HERE="$(dirname "$(readlink -f "$0")")"
if [ -n "$APPIMAGE" ]; then OUTSIDE="$(dirname "$APPIMAGE")"; else OUTSIDE="$HERE"; fi   # folder holding the AppImage, or the unpacked folder itself
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/stun60"
mkdir -p "$DATA/roms" "$DATA/cfg" "$DATA/nvram" "$DATA/snap"
ROMPATH="$OUTSIDE;$OUTSIDE/roms;$DATA/roms;$HOME/mame/roms"
found=""
for d in "$OUTSIDE" "$OUTSIDE/roms" "$DATA/roms" "$HOME/mame/roms"; do
  if [ -e "$d/stunrun.zip" ] || [ -d "$d/stunrun" ]; then found=1; fi
done
if [ -z "$found" ]; then
  msg="stunrun.zip not found. Put it next to the app, or in $DATA/roms."
  zenity --error --text="$msg" 2>/dev/null || kdialog --error "$msg" 2>/dev/null || notify-send "S.T.U.N. Runner 60" "$msg" 2>/dev/null
  echo "$msg" >&2; exit 1
fi
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export STUN60_CLOCK="${STUN60_CLOCK:-maincpu=3,gsp=4,adsp=8}"
export STUN60_DATA="$DATA"
cd "$DATA"
exec "$HERE/usr/bin/stun60" stunrun -inipath "$DATA" -rompath "$ROMPATH" \
  -cfg_directory "$DATA/cfg" -nvram_directory "$DATA/nvram" -snapshot_directory "$DATA/snap" \
  -skip_gameinfo -sound portaudio -audio_latency 3 \
  -autoboot_script "$HERE/usr/share/stun60/stunrun-interp60.lua" "$@" 2> "$DATA/stderr.log"
